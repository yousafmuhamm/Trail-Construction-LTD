# Copy to .env.local and fill in. All server-side — no NEXT_PUBLIC_ prefix,
# so none of these are exposed to the browser.

# The mailbox the form sends *from*. For Gmail this is the full address plus a
# 16-character App Password (not the account password — that will not work).
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to Gmail: smtp.gmail.com on port 465.
# Port 587 also works — the route switches to STARTTLS automatically.
SMTP_HOST=
SMTP_PORT=

# Optional. Where leads are delivered. Falls back to business.email in lib/content.ts.
CONTACT_TO_EMAIL=
